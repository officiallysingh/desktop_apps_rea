{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(file:*)",
      "Bash(strings:*)",
      "Bash(ilspycmd:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(reg query:*)",
      "Bash(reg export:*)",
      "Bash(sqlite3:*)",
      "mcp__rea"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(./.claude/protected.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/app_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
