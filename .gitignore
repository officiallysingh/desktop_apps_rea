# Claude Code local-only settings
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
__pycache__/
.venv/
node_modules/


# Screens/reports of apps with REAL client data stay in _raw; never commit them from app folders
*/03-screens/*.png
*/03-screens/*.jpg
*/03-screens/*.ui.json
*/06-reports/sample-outputs/*
!*/06-reports/sample-outputs/.gitkeep

